# Base de datos Postgres. Usá la que te dé Vercel Postgres (Storage tab),
# o una gratuita de Neon/Supabase:
# DATABASE_URL="postgresql://usuario:password@host:5432/basededatos"
DATABASE_URL="postgresql://usuario:password@host:5432/basededatos"

# Secreto usado para firmar las cookies de sesión. Generar uno propio:
# openssl rand -base64 48
SESSION_SECRET="cambiar-por-un-secreto-largo-y-aleatorio"
